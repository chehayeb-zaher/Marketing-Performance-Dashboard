# GoHighLevel Private Integration token (server-only — never exposed to the browser)
GHL_PRIVATE_TOKEN=

# GoHighLevel Location ID (sub-account) this dashboard reports on
GHL_LOCATION_ID=

# GoHighLevel API base URL
GHL_API_BASE_URL=https://services.leadconnectorhq.com

# GoHighLevel API version header value
GHL_API_VERSION=v3

# IANA timezone used to convert the reporting date range to UTC boundaries
REPORT_TIMEZONE=UTC
